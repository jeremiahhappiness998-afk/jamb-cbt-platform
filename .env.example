# Local SQLite database (resolved relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Optional in local development (a temporary process-local key is generated).
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret-min-32-characters"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
